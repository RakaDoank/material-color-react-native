{
	"name": "material-color-react-native",
	"private": true,
	"scripts": {
		"code-check": "npm run type-check && npm run lint",
		"lint": "eslint",
		"package-builder": "package-builder",
		"bun-clean-install": "bun ./scripts/bun-clean-install.mts",
		"prepare": "husky",
		"type-check": "bun check --build",
		"type-check:ts": "tsc --build"
	},
