			"react-dom": "19.2.3"
		}
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@react-native/eslint-config": "0.86.2",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^24",
		"@types/color": "4.2.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/react-native-web": "0.19.3",
		"@types/semver": "7.8.0",
		"eslint": "10.13.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-native": "5.0.0",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"package-builder": "workspace:*",
		"semver": "7.8.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1"
	},
