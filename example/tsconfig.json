{
  "extends": [
    "expo/tsconfig.base",
    "../tsconfig.base.react-native.json"
  ],
  "compilerOptions": {
	"composite": true,
    "paths": {
      "@/*": [
        "./src/*/index"
      ],
      "material-color-react-native": [
        "../package/src/index"
      ],
      "material-color-react-native/react-native-paper": [
        "../package/src/subpaths/react-native-paper/index"
      ]
    },
    "types": [
      "react-native-web"
    ]
  },
  "include": [
    "../package/src/**/*",
    "./app.config.ts",
    "./index.ts",
    "./src/**/*"
  ]
}
